# ==============================================================================
# CITYLINKS APP ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to `.env` in the `citylinks-app` folder:
#
# To switch environments, simply comment (#) one option and uncomment the other:

# --- [PRODUCTION] Cloudflare VPS Domain ---
EXPO_PUBLIC_API_URL=https://api.citylinks.in/api
EXPO_PUBLIC_HEALTH_CHECK_URL=https://api.citylinks.in/api/health

# --- [LOCAL] Localhost / Wi-Fi IP (Uncomment to test locally) ---
# EXPO_PUBLIC_API_URL=http://localhost:5001/api
# EXPO_PUBLIC_API_URL=http://192.168.0.108:5001/api
# EXPO_PUBLIC_HEALTH_CHECK_URL=http://localhost:5001/api/health
