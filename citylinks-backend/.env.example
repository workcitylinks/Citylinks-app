PORT=5001
DATABASE_URL="postgresql://user:password@localhost:5432/citylinks?schema=public"

#### nodemailer
MY_EMAIL=work.citylinks@gmail.com
MY_PASSWORD="app_password_here"

# ==============================================================================
# API DOMAIN & HEALTH CHECK URL
# ==============================================================================
# [PRODUCTION] Cloudflare Domain (Active)
API_BASE_URL="https://api.citylinks.in/api"
HEALTH_CHECK_URL="https://api.citylinks.in/api/health"
GOOGLE_CALLBACK_URL="https://api.citylinks.in/api/auth/google/callback"

# [LOCAL DEVELOPMENT] Uncomment below lines and comment above to run locally:
# API_BASE_URL="http://localhost:5001/api"
# HEALTH_CHECK_URL="http://localhost:5001/api/health"
# GOOGLE_CALLBACK_URL="http://192.168.0.108.nip.io:5001/api/auth/google/callback"
# GOOGLE_CALLBACK_URL="http://localhost:5001/api/auth/google/callback"

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID="google_client_id_here"
GOOGLE_CLIENT_SECRET="google_client_secret_here"

# Cloudflare Images Credentials
CLOUDFLARE_ACCOUNT_ID="cloudflare_account_id_here"
CLOUDFLARE_ACCOUNT_HASH="cloudflare_account_hash_here"
CLOUDFLARE_API_TOKEN="cloudflare_api_token_here"
